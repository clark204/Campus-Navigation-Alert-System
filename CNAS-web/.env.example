APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email verification codes go out through the queue with these settings (any SMTP server). With MAIL_MAILER=log the
# codes only appear in storage/logs. MAIL_MAILER=failover sends with MAIL_* first and, if that server refuses or is
# down, with MAIL_FALLBACK_* (order: MAIL_FAILOVER_MAILERS). Hostinger: MAIL_SCHEME=smtps, MAIL_HOST=smtp.hostinger.com,
# MAIL_PORT=465. Gmail: MAIL_SCHEME=null, smtp.gmail.com, port 587, a Google "App password" as the password.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_FAILOVER_MAILERS=smtp,smtp_fallback
MAIL_FALLBACK_SCHEME=null
MAIL_FALLBACK_HOST=
MAIL_FALLBACK_PORT=587
MAIL_FALLBACK_USERNAME=
MAIL_FALLBACK_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Emergency alert push notifications (laravel-notification-channels/webpush). Generate keys once with
# `php artisan webpush:vapid` and never change them, or every device has to turn alerts on again.
# VAPID_SUBJECT: mailto:<admin address> or the https site URL (empty = APP_URL).
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Phone alert push (the CNAS mobile app) goes through the Expo push service. Optional: only needed when
# "Enhanced push security" is turned on for the project at expo.dev (then create an access token there).
EXPO_ACCESS_TOKEN=
